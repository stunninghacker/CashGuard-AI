# CashGuard AI — environment configuration
# Copy to `.env` and adjust as needed.

# Database (SQLite default; PostgreSQL in production)
# DATABASE_URL=sqlite:///data/cashguard.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/cashguard

# ML artifacts
# ARTIFACT_DIR=artifacts
# MODEL_FILE=model.joblib

# Alert engine
RISK_THRESHOLD=0.7
ALERT_COOLDOWN_HOURS=6
SCHEDULER_INTERVAL_MINUTES=60
HOTSPOT_K=20

# Demo simulation: leave empty to use latest data timestamp as "now"
# SIMULATED_NOW=2026-08-24T12:00:00

# Mock gateways (real keys go here in production)
SMS_GATEWAY_API_KEY=mock-sms-key
EMAIL_SMTP_HOST=mock.smtp.local

# Misc
SEED=42
CORS_ORIGINS=*