# Data & artifacts (generated at runtime) — exclude everything, then re-include
# the documentation-critical artifact JSONs/PNGs and the real-data README.
# NOTE: use `dir/*` + `!dir/file` form — plain `dir/` stops git from descending,
# so negations never get evaluated.
data/*
!data/real/
!data/real/README.md
artifacts/*
!artifacts/*.json
!artifacts/*.png
!artifacts/deep_eval/
!artifacts/deep_eval/*.json
!artifacts/deep_eval/*.png
artifacts/deep_eval/*.npz
!artifacts/reports/

# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Presentations / docs are tracked; prompt archives are tracked for provenance/internal/
# internal-only planning docs (never commit)

# Runtime logs
logs/
